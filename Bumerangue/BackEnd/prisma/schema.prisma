generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id       Int     @id @default(autoincrement())
  nome     String
  senha    String
  email    String  @unique
  cpf      String  @unique
  telefone String? 
  foto     String?
  cidade   String?
  estado   String?
  pushToken String?
  dataNascimento DateTime?
  ultimoAcesso   DateTime?
  anuncios Anuncio[]
  propostas Proposta[]
   mensagensEnviadas  Mensagem[] @relation("MensagensEnviadas")
  mensagensRecebidas Mensagem[] @relation("MensagensRecebidas")
}

model Categoria{
  id Int @id @default(autoincrement())
  nome String @unique
  anuncios Anuncio[]
}

model Anuncio{
  id Int @id @default(autoincrement())
  titulo String
  descricao String
  preferencia String
  foto String?
  disponibilidade String?        
  status String @default("ativo") 

  
  cidade String?                  
  estado String?                  

  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId Int

  categoria Categoria @relation(fields: [categoriaId], references: [id])
  categoriaId Int

  propostas Proposta[]
  mensagem Mensagem[]
  troca Troca[]
}

model Mensagem {
  id Int @id @default(autoincrement())
  conteudo String
  tipo String @default("texto")
  data_hora DateTime @default(now())

  // Apagar conversa "só para mim": cada lado marca a sua própria cópia como apagada
  apagadaRemetente    Boolean @default(false)
  apagadaDestinatario Boolean @default(false)

  remetenteId Int
  remetente Usuario @relation("MensagensEnviadas", fields: [remetenteId], references: [id], onDelete: Cascade)

  destinatarioId Int  
  destinatario Usuario @relation("MensagensRecebidas", fields: [destinatarioId], references: [id], onDelete: Cascade)

  anuncioId Int
  anuncio Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
}

model Proposta{
  id Int @id @default(autoincrement())
  mensagem String
  status String @default("pendente")
  criadoEm DateTime @default(now())

  anuncioId Int
  anuncio Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)

  propostoPor Int
  usuario Usuario @relation(fields: [propostoPor], references: [id], onDelete: Cascade)
}

model Troca {
  id Int @id @default(autoincrement())

  anuncioId Int
  anuncio Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)

  usuarioAId Int 
  usuarioBId Int 

  usuarioAFoto String? 
  usuarioBFoto String?  

  usuarioAConfirmou Boolean @default(false)
  usuarioBConfirmou Boolean @default(false)

  finalizada Boolean @default(false)
  ultimoEnviouId Int?
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  avaliacao Avaliacao[]

  @@unique([anuncioId, usuarioBId])
}

model Avaliacao {
  id Int @id @default(autoincrement())

  // A troca pode ser apagada junto com o anúncio, mas a avaliação continua existindo
  trocaId Int?
  troca Troca? @relation(fields: [trocaId], references: [id], onDelete: SetNull)

  // Cópia dos dados do anúncio para o histórico não depender dele
  anuncioId Int?
  anuncioTitulo String?

  avaliadorId Int
  avaliadoId Int

  nota Int
  comentario String?
  criadoEm DateTime @default(now())

  @@unique([trocaId, avaliadorId])
  @@index([avaliadoId])
}
