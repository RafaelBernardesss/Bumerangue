generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id       Int     @id @default(autoincrement())
  nome     String
  senha    String
  email    String  @unique
  cpf      String  @unique
  telefone String?
  foto     String?
  cidade   String?
  estado   String?
  anuncios Anuncio[]
  notificacoes Notificacao[]
  expoPushToken String?
  solicitacoesEnviadas SolicitacaoServico[] @relation("SolicitacoesEnviadas")
  servicosPrestados    ServicoEmAndamento[] @relation("ServicosPrestados")
  servicosContratados  ServicoEmAndamento[] @relation("ServicosContratados")
  // Conversas e mensagens (novos modelos)
  conversasDono Conversa[] @relation("ConversaDono")
  conversasSolicitante Conversa[] @relation("ConversaSolicitante")
  mensagensEnviadas Mensagem[] @relation("MensagemRemetente")
}

model Categoria {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  anuncios Anuncio[]
}

model Anuncio {
  id                  Int      @id @default(autoincrement())
  titulo              String
  descricao           String?
  preferencia         String
  foto                String?
  disponibilidade     String?
  status              String   @default("ativo")
  cidade              String?
  estado              String?
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt
  usuario             Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId           Int
  categoria           Categoria @relation(fields: [categoriaId], references: [id])
  categoriaId         Int
  solicitacoes        SolicitacaoServico[]
  servicosEmAndamento ServicoEmAndamento[]
}

model Notificacao {
  id            Int      @id @default(autoincrement())
  mensagem      String
  lida          Boolean  @default(false)
  criadoEm      DateTime @default(now())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId     Int
  tipo          String   @default("info")
  solicitacao   SolicitacaoServico? @relation(fields: [solicitacaoId], references: [id])
  solicitacaoId Int?
}

model SolicitacaoServico {
  id            Int      @id @default(autoincrement())
  status        String   @default("pendente")
  criadoEm      DateTime @default(now())
  anuncio       Anuncio  @relation(fields: [anuncioId], references: [id])
  anuncioId     Int
  solicitante   Usuario  @relation("SolicitacoesEnviadas", fields: [solicitanteId], references: [id])
  solicitanteId Int
  notificacoes  Notificacao[]
  // relação opcional com Conversa (uma solicitação pode gerar uma conversa)
  conversa      Conversa? @relation("SolicitacaoConversa")
}

model ServicoEmAndamento {
  id            Int      @id @default(autoincrement())
  status        String   @default("em_andamento")
  criadoEm      DateTime @default(now())
  anuncio       Anuncio  @relation(fields: [anuncioId], references: [id])
  anuncioId     Int
  prestador     Usuario  @relation("ServicosPrestados", fields: [prestadorId], references: [id])
  prestadorId   Int
  contratante   Usuario  @relation("ServicosContratados", fields: [contratanteId], references: [id])
  contratanteId Int
}

model Conversa {
  id            Int      @id @default(autoincrement())
  solicitacao   SolicitacaoServico? @relation("SolicitacaoConversa", fields: [solicitacaoId], references: [id])
  solicitacaoId Int? @unique
  dono          Usuario  @relation("ConversaDono", fields: [donoId], references: [id])
  donoId        Int
  solicitante   Usuario  @relation("ConversaSolicitante", fields: [solicitanteId], references: [id])
  solicitanteId Int
  mensagens     Mensagem[]
  criadoEm      DateTime @default(now())
}

model Mensagem {
  id          Int      @id @default(autoincrement())
  conversa    Conversa @relation(fields: [conversaId], references: [id])
  conversaId  Int
  remetente   Usuario  @relation("MensagemRemetente", fields: [remetenteId], references: [id])
  remetenteId Int
  texto       String
  criadoEm    DateTime @default(now())
}
