
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")

 
}

model Usuario {
  id       Int     @id @default(autoincrement())
  nome     String
  senha    String
  email    String  @unique
  cpf      String  @unique
  telefone String?
  foto     String?
}